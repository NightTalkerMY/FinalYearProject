# HoloPi environment-variable reference.
# Python entry points read these values from the process environment; this file
# is documentation and is not loaded automatically.

# Central backend and public response URLs
HOLOPI_ORCHESTRATOR_HOST=0.0.0.0
HOLOPI_ORCHESTRATOR_PORT=5000
HOLOPI_PUBLIC_AUDIO_BASE_URL=http://localhost:5000/audio

# Local microservice endpoints
HOLOPI_STT_URL=http://127.0.0.1:8000/transcribe
HOLOPI_LLM_URL=http://127.0.0.1:8001/chat
HOLOPI_RAG_URL=http://127.0.0.1:8002/get_context
HOLOPI_TTS_URL=http://127.0.0.1:8003/generate_speech
HOLOPI_LIPSYNC_URL=http://127.0.0.1:8004
HOLOPI_ALLOSAURUS_URL=http://127.0.0.1:8004/generate_visemes

# MediaMTX and frontend paths. Relative paths are resolved by each entry point.
HOLOPI_MEDIAMTX_DIR=mediamtx
HOLOPI_WATCHDOG_PYTHON=mediamtx/venv/Scripts/python.exe
HOLOPI_MEDIAMTX_CMD=mediamtx.exe
HOLOPI_MEDIAMTX_BASE_URL=http://127.0.0.1:8889
HOLOPI_REACT_DIR=react_avatar
HOLOPI_NODE_SCRIPT=react_avatar/launch-hologram.js
HOLOPI_REACT_URL=http://localhost:5173
HOLOPI_PUPPETEER_DATA_DIR=puppeteer-data
HOLOPI_PUPPETEER_CACHE_DIR=puppeteer-cache

# Backend media input and service control
HOLOPI_CAM1_WHEP_URL=http://127.0.0.1:8889/cam1/whep
HOLOPI_ASD_ORCHESTRATOR_URL=http://127.0.0.1:5000/process_text
HOLOPI_GESTURE_ORCHESTRATOR_URL=http://127.0.0.1:5000/gesture_command
HOLOPI_WAKEWORD_LISTEN_PORT=5050

# Replace these with the current Raspberry Pi address.
HOLOPI_PI_HOST=100.80.70.120
HOLOPI_PI_STOP_URL=http://100.80.70.120:5051/stop
HOLOPI_PI_RESTART_URL=http://100.80.70.120:8000/restart

# Raspberry Pi publisher: replace backend host for the current network.
HOLOPI_BACKEND_HOST=100.100.155.39
HOLOPI_PI_ORCHESTRATOR_URL=http://100.100.155.39:5000/process
HOLOPI_MEDIAMTX_PORT=8889
HOLOPI_MEDIAMTX_INPUT_STREAM=cam1
HOLOPI_PI_LISTEN_PORT=5051
HOLOPI_DESKTOP_WAKEWORD_URL=http://100.100.155.39:5050/wakeword
HOLOPI_DESKTOP_UTTERANCE_URL=http://100.100.155.39:5050/utterance
HOLOPI_WAKEWORD_MODEL=hey_holo.onnx

# Model and asset overrides
HOLOPI_S3FD_WEIGHTS=online_ASD/model/faceDetector/s3fd/sfd_face.pth
HOLOPI_CATT_STUDENT_WEIGHTS=online_ASD/pretrain_model/SOTA_studen_model/holopi_student_best.pt
HOLOPI_TTS_OUTPUT_DIR=TTS/ZipVoice/outputs_zipvoice
HOLOPI_AVATAR_URL=http://localhost:5173/
